# Copy to .env. Never commit .env.

APP_ENV=development
# Local default is SQLite in data/heimkommen.db; Docker compose files set a Postgres URL themselves.
# DATABASE_URL=postgresql+psycopg://heimkommen:heimkommen@localhost:5432/heimkommen
# REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=heimkommen
POSTGRES_USER=heimkommen
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
JWT_SECRET=change-me

# DB API Marketplace, Timetables API (free plan). Leave empty to disable live status.
DB_API_CLIENT_ID=
DB_API_KEY=

SIMULATOR_RUNS=2000
DEFAULT_TRANSFER_MINUTES=4

# Production only
DOMAIN=heimkommen.example.cloudapp.azure.com
GRAFANA_ADMIN_PASSWORD=change-me
CORS_ORIGINS=*
# Impressum / privacy page (build-time, frontend)
VITE_OPERATOR_NAME=
VITE_OPERATOR_ADDRESS=
VITE_OPERATOR_EMAIL=
